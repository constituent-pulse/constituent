{
  "expo": {
    "name": "Constituent",
    "slug": "constituent",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "constituent",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.constituentpulse.constituent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.constituentpulse.constituent",
      "adaptiveIcon": {
        "backgroundColor": "#071827"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071827",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bab3d466-1450-486f-ba31-610dd9be84bf"
      }
    },
    "owner": "constituentpulse"
  }
}
